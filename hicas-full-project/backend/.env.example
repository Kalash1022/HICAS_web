# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://hicas:hicas@localhost:5432/hicas?schema=public
# Prisma migrations use this non-transaction-pooled connection.
DIRECT_URL=postgresql://hicas:hicas@localhost:5432/hicas?schema=public

# One-time initial Admin bootstrap (read only by `npm.cmd run prisma:seed`).
# It is disabled by default and is never read by the running NestJS application.
# Set to true only for the bootstrap command, then remove or clear these values.
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=

# Local demo fixtures are opt-in and reject non-local PostgreSQL targets.
# Run only with npm.cmd run demo:seed after setting both values below.
DEMO_SEED_ENABLED=false
DEMO_SEED_CONFIRM=
FRONTEND_ORIGIN=http://localhost:5173
# Keep 0 for direct access. Use 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud and use an origin listed in FRONTEND_ORIGIN.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Exactly 32 random bytes encoded as base64/base64url or 64 hex characters.
# Generate a distinct value with: openssl rand -base64 32
OAUTH_TRANSACTION_ENCRYPTION_KEY=

# Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# MFA - must be different from OAUTH_TRANSACTION_ENCRYPTION_KEY
MFA_CHALLENGE_TTL_SECONDS=300
MFA_ISSUER=HICAS Commerce
MFA_ENCRYPTION_KEY=

# Mail
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Lean MVP is single-instance and supports only the in-memory rate-limit store.
RATE_LIMIT_STORE=memory
DEFAULT_SHIPPING_FEE_VND=30000

# In-process cleanup scheduler (single backend instance only)
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_BATCH_SIZE=100
# Keep newly uploaded objects out of orphan cleanup while their DB link is created.
ORPHAN_IMAGE_GRACE_PERIOD_SECONDS=3600

# S3-compatible object storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Optional CDN or publicly readable object endpoint. Defaults to S3_ENDPOINT.
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_BUCKET=hicas
S3_ACCESS_KEY=
S3_SECRET_KEY=
