# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/hicas
FRONTEND_ORIGIN=http://localhost:5173

# Google OpenID Connect
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
OAUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-a-32-byte-secret

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# MFA
MFA_CHALLENGE_TTL_SECONDS=300
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-secret

# Mail
MAIL_PROVIDER=console
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Application
RATE_LIMIT_STORE=memory
DEFAULT_SHIPPING_FEE_VND=30000

# S3-compatible object storage
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
